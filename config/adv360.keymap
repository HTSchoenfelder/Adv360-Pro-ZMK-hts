#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            require-prior-idle-ms = <200>;
        };

        hm_left: hm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            hold-trigger-key-positions = <22 23 24 25 26 40 41 42 43 44 54 55 56 57 58>;
            require-prior-idle-ms = <200>;
        };

        hm_right: hm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
            hold-trigger-key-positions = <15 16 17 18 29 30 31 32 47 48 49 50 19 33 51>;
            require-prior-idle-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        NumbersLayer {
            bindings = <&mo 3>;
            key-positions = <66 32>;
        };
    };

    macros {
        snippet_mail: snippet_mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp I &kp L &kp AT &kp H &kp E &kp N &kp R &kp I &kp K &kp S &kp C &kp H &kp O &kp E &kp N &kp F &kp E &kp L &kp D &kp E &kp R &kp DOT &kp D &kp E>;
            label = "SNIPPET_MAIL";
        };

        snippet_stackit: snippet_stackit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp LS(T) &kp LS(A) &kp LS(C) &kp LS(K) &kp LS(I) &kp LS(T)>;
            label = "SNIPPET_STACKIT";
        };

        snippet_profile_1: snippet_profile_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &bt BT_SEL 0>;
            label = "SNIPPET_PROFILE_1";
        };

        snippet_profile_2: snippet_profile_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &bt BT_SEL 1>;
            label = "snippet_profile_2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "Default";
            bindings = <
&none       &none  &none  &none  &none  &none  &tog 7                                                               &mo 8                   &none  &none  &none      &none    &none      &none
&kp TAB     &kp Q  &kp W  &kp E  &kp R  &kp T  &to 1                                                                &to 0                   &kp Y  &kp U  &kp I      &kp O    &kp P      &kp BACKSLASH
&kp ESCAPE  &kp A  &kp S  &kp D  &kp F  &kp G  &to 4                &none      &none         &none     &none        &to 9                   &kp H  &kp J  &kp K      &kp L    &kp SEMI   &kp SINGLE_QUOTE
&kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B                                  &none         &none                                          &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp RSHIFT
&mo 6       &none  &none  &none  &none         &hm LCTRL BACKSPACE  &lt 1 DEL  &kp RALT      &kp LGUI  &lt 2 ENTER  &hm LC(LA(LGUI)) SPACE         &none  &none      &none    &none      &mo 6
            >;
        };

        left {
            bindings = <
&none   &none     &none     &none      &none    &none  &none                                        &none      &none             &none              &none         &none      &none     &none
&none   &none     &none     &none      &none    &none  &none                                        &none      &kp CARET         &kp AMPERSAND      &kp ASTERISK  &kp LPAR   &kp RPAR  &none
&none   &sk LALT  &sk LGUI  &sk LCTRL  &mo 3    &mo 4  &none  &none  &none       &none   &none      &none      &none             &kp MINUS          &kp UNDER     &kp EQUAL  &kp PLUS  &none
&trans  &none     &none     &kp ESC    &kp TAB  &sl 5                &none       &none                         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LBRC      &kp RBRC   &none     &trans
&none   &none     &none     &none      &none           &none  &none  &trans      &trans  &kp ENTER  &kp SPACE                    &none              &none         &none      &none     &none
            >;
        };

        right {
            bindings = <
&none   &none            &none      &none      &none       &none        &none                                              &none  &none     &none      &none      &none      &none  &none
&none   &kp EXCLAMATION  &kp AT     &kp HASH   &kp DOLLAR  &kp PERCENT  &none                                              &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none  &none
&none   &kp LALT         &kp LGUI   &kp LCTRL  &none       &none        &none          &none    &none       &none   &none  &none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none  &none
&trans  &kp TILDE        &kp GRAVE  &none      &none       &none                                &none       &none                 &none     &none      &none      &none      &none  &trans
&none   &none            &none      &none      &none                    &kp BACKSPACE  &kp DEL  &trans      &trans  &none  &none            &none      &none      &none      &none  &none
            >;
        };

        numbers {
            bindings = <
&none   &none     &none     &none      &none  &none  &none                                    &none   &none         &none   &none   &none   &none       &none
&none   &none     &none     &none      &none  &none  &none                                    &none   &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp COMMA   &none
&none   &kp LALT  &kp LGUI  &kp LCTRL  &none  &none  &none  &none  &none       &none   &none  &none   &kp MINUS     &kp N4  &kp N5  &kp N6  &kp PLUS    &none
&trans  &none     &none     &none      &none  &none                &none       &none                  &kp SLASH     &kp N1  &kp N2  &kp N3  &kp PERIOD  &none
&none   &none     &none     &none      &none         &none  &none  &trans      &trans  &none  &kp N0                &none   &none   &none   &none       &none
            >;
        };

        mouse {
            bindings = <
&none   &none  &none  &none  &none  &none  &none                                   &none      &none  &none           &none           &none            &none      &none
&none   &none  &none  &none  &none  &none  &none                                   &none      &none  &none           &mmv MOVE_UP    &none            &none      &none
&none   &none  &none  &none  &none  &none  &none   &none  &none      &none  &none  &none      &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK  &none
&trans  &none  &none  &none  &none  &none                 &none      &none                    &none  &none           &mkp MCLK       &none            &none      &trans
&none   &none  &none  &none  &none         &tog 4  &none  &none      &none  &none  &mkp LCLK         &none           &none           &none            &none      &none
            >;
        };

        macros {
            bindings = <
&none   &none  &none  &none  &none  &none  &none                                  &none  &none  &none             &none  &none  &none  &none
&none   &none  &none  &none  &none  &none  &none                                  &none  &none  &none             &none  &none  &none  &none
&none   &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &snippet_stackit  &none  &none  &none  &none
&trans  &none  &none  &none  &none  &none                &none      &none                &none  &snippet_mail     &none  &none  &none  &trans
&none   &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none             &none  &none  &none  &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans                                      &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none   &none  &none  &none  &none  &none  &none                                  &none      &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&none   &none  &none  &none  &none  &none  &none                                  &none      &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&none   &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none      &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&trans  &none  &none  &none  &none  &none                &none      &none                    &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&none   &none  &none  &none  &none         &none  &none  &none      &none  &none  &kp KP_N0         &none       &none         &kp KP_DOT     &none            &none
            >;
        };

        mod {
            display-name = "mod";
            bindings = <
&none           &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &mo 8            &none  &none       &none       &none  &none  &none
&none           &snippet_profile_2  &snippet_profile_2  &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none               &none               &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&trans          &none               &none               &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none               &none               &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        no_home_row_mods {
            display-name = "NoHomeRowMods";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                              &trans     &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &trans                                                              &trans     &kp Y   &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &trans    &kp LCTRL  &kp LALT                  &kp LALT  &kp RCTRL  &trans     &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp LS(LA(LC(LGUI)))      &kp LGUI                        &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 7      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp RALT                  &kp RALT  &kp ENTER  &kp SPACE          &kp DOWN  &kp UP     &kp LBKT  &kp RBKT  &mo 7
            >;
        };
    };
};
